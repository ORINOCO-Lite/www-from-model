{% extends "page.md.j2" %}
{% from "person_links.md.j2" import profile_links %}

{% block frontmatter -%}
title: {{ given_name }} {{ family_name }}
{% endblock -%}

{%- block frontmatter_params -%}
{%- set fields = ["given_name", "family_name", "identifiers", "description"] %}
{%- set p = {} %}
{%- for f in fields %}
  {%- if f in __rec and __rec[f] %}
    {%- set _ = p.update({f: __rec[f]}) %}
  {%- endif %}
{%- endfor %}
  {{ p | toyaml | indent(2) | trim }}
{% endblock -%}

{% block content %}
{% block profile_links %}{{ profile_links(__rec) }}{% endblock %}
{% endblock %}
